Rel(UserComp,APIGW,"Обработка запроса/ответ")
Rel(HeatComp,APIGW,"Обработка запроса/ответ")
Rel(TempComp,APIGW,"Обработка запроса/ответ")
Rel(GateComp,APIGW,"Обработка запроса/ответ")
Rel(LightControlComp,APIGW,"Обработка запроса/ответ")
