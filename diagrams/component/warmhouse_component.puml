@startuml WarmhouseComponent
title Warmhouse 2.0 Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container_Boundary(WarmhouseSystem, "Warmhouse System") {
  Container(MobileApp, "Mobile Application", "Kotlin, Swift", "Обработка взаймодействий с пользователем")
  Container(McFrontends, "Microfrontends/ModuleFederation", "React", "Обработка взаимодействий с пользователями")
  Container(APIGW, "API GateWay", "Kong", "Обработка и маршрутизация запросов/ответов пользователям")
  Container(Kafka, "Kafka", "Обеспечение и балансировка внутрисистемного ассинхронного взаимодействия")
  Container(McRuleHeat, "MicroService Rule Heating", "Node.js", "Обработка запросов пользователей")
  Container(McRuleLight, "MicroService Rule Light", "Node.js", "Обработка запросов пользователей")
  Container(McRuleGate, "MicroService Rule Gate", "Node.js", "Обработка запросов пользователей")
  Container(McContTemp, "MicroService Control Temperature", "Node.js", "Обработка запросов пользователей")
  Container(McContLight, "MicroService Control Light", "Node.js", "Обработка запросов пользователей")
  Container(McVideo, "MicroService Video", "Управление видеотрансляцией")
  Container(McUserProf, "MicroService UserProfile", "Node.js", "Управление данными о пользователях")
  Container(McUserAAA, "MicroService AAA", "Node.js", "Авторизация, аутентификация и аудит пользователей")
  Container(McDeviceProf, "MicroService DeviceProfile", "Node.js", "Управление данными о подключенных устройствах и сенсорах")
  Container(McNotif, "MicroService Notification", "Node.js", "Нотификация пользователю")
  Container(PaymentService, "Payment Service", "Node.js", "Управление платежами")
  Container(Adminka, "Administraton", "elasticsearch/grafana", "Логи, мониторинг, метрики, анализ, визуализация")
}

Container(McFrontends, "Microfrontends/ModuleFederation", "React") {
  Component(Host, "Host Module Federation", "Host")
  Component(AuthComp, "AAA Micro Frontend", "Авторизация и аутентификация")
  Component(UserComp, "User Micro Frontend", "Профиль пользователя")
  Component(HeatComp, "Heating Micro Frontend", "Управление отоплением")
  Component(TempComp, "Temperature Micro Frontend", "Градусник")
  Component(GateComp, "Gate Micro Frontend", "Управление воротами")
  Component(LightControlComp, "Light Control Micro Frontend", "Управление светом")
  Component(VideoComp, "Video Micro Frontend", "Видеотрансляция")
  Component(LightComp, "Light Micro Frontend", "Мониторинг освещения")
  Component(Payments, "Payments Micro Frontend", "Управление платежами")
  Component(DevComp, "Devices", "Подключенные устройства")
}

Container(McRuleHeat, "MicroService Rule Heating", "Node.js") {
  Component(APIHeat, "API Heatind component", "Маршрутизация команд")
  Component(HeatRule, "Heating manager", "Обработка команд")
  Component(HeatStat, "Heating State", "Состояние устройств отопления")
  Component(HeatRepo, "Repository layer", "Обработка команд чтвения/записи данных")
  Component(DBHeat, "Heating Database", "PostgreSQL", "Чтение/запись данных")
}

Container(McContTemp, "MicroService Control Temperature", "Node.js") {
  Component(APITemp, "API Temperature", "Маршрутизация команд")
  Component(TempContr, "Temperature Control", "Обработка команд")
  Component(DBTemp, "Temperature Database", "PostgreSQL", "Чтение/запись данных")
}

Container(McUserProf, "MicroService UserProfile", "Node.js") {
  Component(APIUser, "API User", "Маршрутизация команд")
  Component(UserData, "User Data", "Обработка команд/информации")
  Component(DBUser, "User Database", "PostgreSQL", "Чтение/запись данных")
}

Container(McUserAAA, "MicroService AAA", "Node.js") {
  Component(APIUserAAA, "API UserAAA", "Маршрутизация команд")
  Component(UserAAA, "User AAA", "Обработка команд/информации")
  Component(DBUserAAA, "User AAA Database", "PostgreSQL", "Чтение/запись данных")
}

Container(McDeviceProf, "MicroService DeviceProfile", "Node.js") {
  Component(APIDevice, "API Device Data", "Маршрутизация команд")
  Component(DeviceMan, "Device manager", "Обработка команд/информации")
  Component(DBDevices, "DevicesDatabase", "PostgreSQL", "Чтение/запись данных")
}

Container(McNotif, "MicroService Notification", "Node.js") {
  Component(APINotif, "API Notification", "Маршрутизация команд")
  Component(NotifMan, "Notification manager", "Обработка команд/информации")
  Component(DBNotif, "Notification Database", "PostgreSQL", "Чтение/запись данных")
}

Container(PaymentService, "Payment Service", "Node.js") {
  Component(APIPayment, "API Payment", "Маршрутизация команд")
  Component(PayMan, "Payment manager", "Обработка команд/информации")
  Component(DBPayment, "Payments Database", "PostgreSQL", "Чтение/запись данных")
}

System_Ext(hscontroller, "Heating system controller", "Управляет системой отопления в доме")
System_Ext(tsensor, "Temperature sensor", "Замеряет текущую температуру в доме")
System_Ext(lcontroller, "Light system controller", "Управляет системой освещения в доме")
System_Ext(lsensor, "Light sensor", "Измеряет освещенность")
System_Ext(gcontroller, "Gate controller", "Открывает или закрывает ворота")
System_Ext(videoreg, "Video registrator", "Внешняя камера для видеонаблюдения")
System_Ext(paysystem, "Payment System", "Внешний сервис обработки платежей")
System_Ext(sms, "SMS ", "Отправка SMS пользователю")

Rel(user, MobileApp, "Включает/выключает отопление, свет, открывает/закрывает ворота; Просматривает видеотрансляцию он-лайн; Подключает новые устройства; Устанавливает желаемую температуру; Просматривает данные о температуре; Оплачивает сервисы")
Rel(user, Host, "Включает/выключает отопление, свет, открывает/закрывает ворота; Просматривает видеотрансляцию он-лайн; Подключает новые устройства; Устанавливает желаемую температуру; Просматривает данные о температуре; Оплачивает сервисы")
