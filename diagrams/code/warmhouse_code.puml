@startuml WarmhouseCode
title Warmhouse 2.0 Code Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

class User {
  -String name
  -String email
  -boolean isLoggedIn
  -boolean isBlocked
  +User(String name, String email)
  +String getName()
  +void setName(String name)
  +String getEmail()
  +void setEmail(String email)
  +void register()
  +void login()
  +void logout()
  +void block()
  +void unblock()
  +boolean isLoggedIn()
  +boolean isBlocked()
}

class House {
  -String address
  -User owner
  +String getAddress()
  +void setAddress(String address)
  +User getOwner()
  +void setOwner(User owner)
}

class Device {
  -String deviceID
  -String deviceType
  -String serialNumber
  -Date dateStart
  +void turnOn()
  +void turnOff()
  +String getStatus()
  +void setDeviceID(String deviceID)
  +String getDeviceID()
  +void setDeviceType(String deviceType)
  +String getDeviceType()
  +void setSerialNumber(String serialNumber)
  +String getSerialNumber()
  +void setDateStart(Date dateStart)
  +Date getDateStart()
}

class DeviceTelemetry {
  -String telemetryData
  -Device device
  +void setTelemetryData(String telemetryData)
  +String getTelemetryData()
  +Device getDevice()
  +void setDevice(Device device)
}

User "1" -- "0..*" House : owns
House "1" -- "0..*" Device : contains
Device "1" -- "0..*" DeviceTelemetry : generates

@enduml